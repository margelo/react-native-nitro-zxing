{
  "name": "react-native-vision-camera-zxing",
  "version": "0.1.0",
  "description": "Barcode scanning plugin for react-native-vision-camera powered by zxing-cpp.",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "android/CMakeLists.txt",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "cpp/*.h",
    "cpp/*.hpp",
    "cpp/*.cpp",
    "cpp/zxing-core/core",
    "cpp/zxing-core/wrappers/ios/Sources/Wrapper/Version.h",
    "cpp/zxing-core/LICENSE",
    "nitro.json",
    "*.podspec",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf android/build node_modules/**/android/build lib",
    "build": "tsc",
    "typescript": "tsc",
    "specs": "tsc --noEmit false && nitrogen",
    "prepack": "test -f cpp/zxing-core/core/CMakeLists.txt || (echo 'zxing-core submodule missing: run git submodule update --init' && exit 1)",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "camera",
    "react-native-camera",
    "vision-camera",
    "barcode",
    "barcode-scanner",
    "qr-code",
    "qrcode",
    "scanner",
    "code-scanner",
    "zxing",
    "zxing-cpp",
    "frame-processor",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/margelo/react-native-vision-camera-zxing.git"
  },
  "author": "Margelo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/margelo/react-native-vision-camera-zxing/issues"
  },
  "homepage": "https://github.com/margelo/react-native-vision-camera-zxing",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "nitrogen": "0.37.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.0",
    "react-native-vision-camera": "5.2.3",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-image": "*",
    "react-native-nitro-modules": "*",
    "react-native-vision-camera": "*"
  },
  "peerDependenciesMeta": {
    "react-native-nitro-modules": {
      "optional": true
    }
  },
  "release-it": {
    "npm": {
      "publish": true
    },
    "git": false,
    "github": {
      "release": false
    },
    "hooks": {
      "before:init": "bun typecheck",
      "after:bump": "bun run build"
    }
  }
}
